# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/smartspend?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="your-generated-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# WSO2 Identity Server / Asgardeo OIDC Configuration
WSO2IS_HOST="https://api.asgardeo.io/t/your-org"
WSO2IS_CLIENT_ID="your-wso2-client-id"
WSO2IS_CLIENT_SECRET="your-wso2-client-secret"

# Google Gemini AI Integration (Optional)
# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
# Optional: override default model (e.g. gemini-2.5-flash, gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.5-flash"
